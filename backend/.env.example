# Copy this file to .env and fill in your real keys.
# Never commit the actual .env file.

# Get a free key at https://tavily.com
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx

# Get a free key at https://aistudio.google.com (click "Get API key")
# No credit card required, ongoing free tier
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL for the mock API (used later by agent tool wrappers)
MOCK_API_BASE_URL=http://localhost:8000
